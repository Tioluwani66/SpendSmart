@{
    ViewData["Title"] = "Create / Edit";
}

@model SpendSmart.Models.Expense

<div class="text-center">
    <h1 class="display-4">Create or Edit an expense</h1>
</div>

<form asp-action="CreateEditExpenseForm" asp-controller="Home" method="post">
    <input hidden class="form-control" type="number" placeholder="0" asp-for="Id" />

    <!-- Hidden Date Input -->
    <input type="hidden" asp-for="Date" />

    <label class="mt-4">Value ₦</label>
    <!-- ADDED: required attribute and min="0.01" -->
    <input class="form-control"
           type="number"
           step="0.01"
           min="0.01"
           placeholder="Enter amount"
           asp-for="Value"
           value="@(Model?.Id == 0 ? "" : Model?.Value.ToString())"
           required />

    <label class="mt-4">Description</label>
    <!-- ADDED: required attribute -->
    <input class="form-control"
           type="text"
           placeholder="Add a description"
           asp-for="Description"
           required />

    <button class="btn btn-primary mt-4" type="submit">Ok</button>
</form>