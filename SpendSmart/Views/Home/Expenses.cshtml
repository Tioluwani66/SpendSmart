@{
    ViewData["Title"] = "Expenses";
}

@model List<Expense>

<div class="container py-2">
    <!-- Header Section with Title & Create Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Expenses</h1>
            <p class="text-muted mb-0">Manage and track your overall spending</p>
        </div>
        <a class="btn btn-primary px-4 py-2 shadow-sm fw-medium" asp-action="CreateEditExpense">
            + Add New Expense
        </a>
    </div>

    <!-- Total Summary Card -->
    <div class="card p-4 mb-4 text-center border-secondary shadow-sm">
        <span class="text-muted text-uppercase fw-semibold small">Total Expenses</span>
        <h2 class="display-6 fw-bold text-primary mb-0">₦@ViewBag.Expenses</h2>
    </div>

    <!-- Expenses Table Card -->
    <div class="card border-secondary shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="border-bottom border-secondary">
                    <tr class="text-secondary small text-uppercase">
                        <th scope="col" class="ps-4">Id</th>
                        <th scope="col">Value</th>
                        <th scope="col">Description</th>
                        <th scope="col">Date & Time</th> <!-- ADDED DATE HEADER -->
                        <th scope="col" class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var expense in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted fw-semibold">#@expense.Id</td>
                                <td class="fw-bold text-light">₦@expense.Value</td>
                                <td>@expense.Description</td>

                                <!-- ADDED EXACT TIMESTAMP CELL -->
                                <td class="text-secondary small">
                                    @(expense.Date.Year > 2000 ? expense.Date.AddHours(1).ToString("yyyy-MM-dd HH:mm:ss") : "N/A")
                                </td>

                                <td class="text-end pe-4">
                                    <!-- Edit Button -->
                                    <a class="btn btn-sm btn-outline-info me-1 px-3"
                                       asp-action="CreateEditExpense"
                                       asp-route-id="@expense.Id">
                                        Edit
                                    </a>
                                    <!-- Delete Button -->
                                    <a class="btn btn-sm btn-outline-danger px-3"
                                       asp-action="DeleteExpense"
                                       asp-route-id="@expense.Id"
                                       onclick="return confirm('Are you sure you want to delete this expense?');">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <!-- UPDATED COLSPAN TO 5 FOR EMPTY STATE -->
                            <td colspan="5" class="text-center py-4 text-muted">
                                No expenses found. Click <strong>+ Add New Expense</strong> above to get started.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>